ecute_reply.started":"2026-07-25T08:57:29.030848Z","shell.execute_reply":"2026-07-25T08:57:29.216989Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"df_train = pd.read_csv(DATA_DIR + \"train.csv\")\ndf_train.head()","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:29.218978Z","iopub.execute_input":"2026-07-25T08:57:29.219444Z","iopub.status.idle":"2026-07-25T08:57:29.366543Z","shell.execute_reply.started":"2026-07-25T08:57:29.219391Z","shell.execute_reply":"2026-07-25T08:57:29.3657Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"df_test = pd.read_csv(DATA_DIR + \"test.csv\")\ndf_test.head()","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:29.368676Z","iopub.execute_input":"2026-07-25T08:57:29.369221Z","iopub.status.idle":"2026-07-25T08:57:29.417282Z","shell.execute_reply.started":"2026-07-25T08:57:29.369194Z","shell.execute_reply":"2026-07-25T08:57:29.416574Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Let's look at some pairs of sentences.","metadata":{}},{"cell_type":"code","source":"def display_pair_of_sentence(x):\n    print( \"Premise : \" + x['premise'])\n    print( \"Hypothesis: \" + x['hypothesis'])\n    print( \"Language: \" + x['language'])\n    print( \"Label: \" + str(x['label']))\n    print()\n\ndf_train.head(10).apply(lambda x : display_pair_of_sentence(x), axis=1)\n\ndf_train.shape","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:29.418189Z","iopub.execute_input":"2026-07-25T08:57:29.418489Z","iopub.status.idle":"2026-07-25T08:57:29.427308Z","shell.execute_reply.started":"2026-07-25T08:57:29.418451Z","shell.execute_reply":"2026-07-25T08:57:29.426658Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Explore the dataset\n\nLet's look at the distribution of labels in the training set.","metadata":{}},{"cell_type":"code","source":"# Initialize the matplotlib figure\nf, ax = plt.subplots(figsize=(12, 4))\n\n# Plot the total crashes\nsns.set_color_codes(\"pastel\")\nsns.despine()\nax = sns.countplot(data=df_train, \n                   y=\"label\",\n                   order = df_train['label'].value_counts().index)\n\nabs_values = df_train['label'].value_counts(ascending=False)\nrel_values = df_train['label'].value_counts(ascending=False, normalize=True).values * 100\nlbls = [f'{p[0]} ({p[1]:.0f}%)' for p in zip(abs_values, rel_values)]\n\nax.bar_label(container=ax.containers[0], labels=lbls)\n\nax.set_yticklabels([RESULT_DICT[index] for index in abs_values.index])\n\nax.set_title(\"Distribution of labels in the training set\")","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:29.428518Z","iopub.execute_input":"2026-07-25T08:57:29.42874Z","iopub.status.idle":"2026-07-25T08:57:29.690778Z","shell.execute_reply.started":"2026-07-25T08:57:29.42872Z","shell.execute_reply":"2026-07-25T08:57:29.689865Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Let's look at the distribution of languages in the training set.","metadata":{}},{"cell_type":"code","source":"# Initialize the matplotlib figure\nf, ax = plt.subplots(figsize=(10, 10))\n\n# Plot the total crashes\nsns.set_color_codes(\"pastel\")\nsns.despine()\nax = sns.countplot(data=df_train, \n                   y=\"language\",\n                   order = df_train['language'].value_counts().index)\n\nabs_values = df_train['language'].value_counts(ascending=False)\nrel_values = df_train['language'].value_counts(ascending=False, normalize=True).values * 100\nlbls = [f'{p[0]} ({p[1]:.0f}%)' for p in zip(abs_values, rel_values)]\n\nax.bar_label(container=ax.containers[0], labels=lbls)\n\nax.set_title(\"Distribution of languages in the training set\")","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:29.691953Z","iopub.execute_input":"2026-07-25T08:57:29.692427Z","iopub.status.idle":"2026-07-25T08:57:30.015252Z","shell.execute_reply.started":"2026-07-25T08:57:29.692394Z","shell.execute_reply":"2026-07-25T08:57:30.014594Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Let's look at the length of the sentences","metadata":{}},{"cell_type":"code","source":"df_train[\"premise_length\"] = df_train[\"premise\"].apply(lambda x : len(x))\ndf_train[\"hypothesis_length\"] = df_train[\"hypothesis\"].apply(lambda x : len(x))\ndf_train[[\"hypothesis_length\", \"premise_length\"]].describe()","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:30.016093Z","iopub.execute_input":"2026-07-25T08:57:30.016632Z","iopub.status.idle":"2026-07-25T08:57:30.044581Z","shell.execute_reply.started":"2026-07-25T08:57:30.016605Z","shell.execute_reply":"2026-07-25T08:57:30.043952Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Preprocess the data\n\nText inputs need to be tokenized into numeric token ids before being fed into the model.\n\nWe fine-tune [`xlm-roberta-base`](https://huggingface.co/xlm-roberta-base), a multilingual transformer pretrained on 100 languages (CommonCrawl), which is a well-suited, actively maintained modern replacement for the `bert_base_multi` KerasNLP preset. Its tokenizer packs the `(premise, hypothesis)` pair together automatically with the right special tokens, same as BERT-style NLI setups.","metadata":{}},{"cell_type":"code","source":"MODEL_NAME = \"xlm-roberta-base\"\nVALIDATION_SPLIT = 0.3\nBATCH_SIZE = 16\nMAX_LENGTH = 128\n\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\n\n# Guard against a missing pad token (seen when the tokenizer falls back to a\n# generic fast tokenizer, e.g. if `sentencepiece` isn't installed).\nif tokenizer.pad_token is None:\n    tokenizer.add_special_tokens({\"pad_token\": \"<pad>\"})","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:30.045483Z","iopub.execute_input":"2026-07-25T08:57:30.045806Z","iopub.status.idle":"2026-07-25T08:57:34.061934Z","shell.execute_reply.started":"2026-07-25T08:57:30.04575Z","shell.execute_reply":"2026-07-25T08:57:34.061178Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Here's how we turn the raw `(premise, hypothesis, label)` rows into tokenized tensors that `Trainer` can consume.\n\nWe split into train/validation with `train_test_split` (stratified on `label`), wrap each split in a Hugging Face `Dataset`, and tokenize the `premise`/`hypothesis` pair in one call — the tokenizer inserts the right special tokens for us automatically.","metadata":{}},{"cell_type":"code","source":"train_df, val_df = train_test_split(\n    df_train,\n    test_size=VALIDATION_SPLIT,\n    random_state=42,\n    stratify=df_train[\"label\"],\n)\n\ndef to_hf_dataset(df):\n    return Dataset.from_pandas(\n        df[[\"premise\", \"hypothesis\", \"label\"]].reset_index(drop=True)\n    )\n\ntrain_dataset = to_hf_dataset(train_df)\nval_dataset = to_hf_dataset(val_df)\n\ndef tokenize_batch(batch):\n    return tokenizer(\n        batch[\"premise\"],\n        batch[\"hypothesis\"],\n        truncation=True,\n        max_length=MAX_LENGTH,\n        padding=\"max_length\",\n    )\n\ntrain_tokenized = train_dataset.map(tokenize_batch, batched=True)\nval_tokenized = val_dataset.map(tokenize_batch, batched=True)\n\ntrain_tokenized = train_tokenized.rename_column(\"label\", \"labels\")\nval_tokenized = val_tokenized.rename_column(\"label\", \"labels\")\n\ncolumns = [\"input_ids\", \"attention_mask\", \"labels\"]\ntrain_tokenized.set_format(type=\"torch\", columns=columns)\nval_tokenized.set_format(type=\"torch\", columns=columns)","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:34.062792Z","iopub.execute_input":"2026-07-25T08:57:34.063111Z","iopub.status.idle":"2026-07-25T08:57:38.350846Z","shell.execute_reply.started":"2026-07-25T08:57:34.063086Z","shell.execute_reply":"2026-07-25T08:57:38.349923Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Load XLM-RoBERTa from Hugging Face Transformers - Train the model","metadata":{}},{"cell_type":"code","source":"model = AutoModelForSequenceClassification.from_pretrained(MODEL_NAME, num_labels=3)\nmodel.resize_token_embeddings(len(tokenizer))  # no-op unless the pad-token guard above added a token\nmodel.to(device)\n\ndef compute_metrics(eval_pred):\n    logits, labels = eval_pred\n    preds = np.argmax(logits, axis=-1)\n    return {\"accuracy\": (preds == labels).mean()}\n\ntraining_args = TrainingArguments(\n    output_dir=\"./results\",\n    per_device_train_batch_size=BATCH_SIZE,\n    per_device_eval_batch_size=BATCH_SIZE * 2,\n    learning_rate=2e-5,\n    num_train_epochs=3,\n    eval_strategy=\"epoch\",\n    save_strategy=\"epoch\",\n    load_best_model_at_end=True,\n    metric_for_best_model=\"accuracy\",\n    fp16=torch.cuda.is_available(),\n    logging_steps=50,\n    report_to=\"none\",\n)\n\ntrainer = Trainer(\n    model=model,\n    args=training_args,\n    train_dataset=train_tokenized,\n    eval_dataset=val_tokenized,\n    compute_metrics=compute_metrics,\n)","metadata":{"execution":{"iopub.status.busy":"2026-07-25T08:57:38.352323Z","iopub.execute_input":"2026-07-25T08:57:38.352678Z","iopub.status.idle":"2026-07-25T08:57:44.38573Z","shell.execute_reply.started":"2026-07-25T08:57:38.352651Z","shell.execute_reply":"2026-07-25T08:57:44.38497Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Train your own model - Fine-tuning XLM-RoBERTa","metadata":{}},{"cell_type":"code","source":"train_result = trainer.train()\nprint(train_result.metrics)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-25T08:57:44.387413Z","iopub.execute_input":"2026-07-25T08:57:44.3878Z","iopub.status.idle":"2026-07-25T09:07:24.246489Z","shell.execute_reply.started":"2026-07-25T08:57:44.387739Z","shell.execute_reply":"2026-07-25T09:07:24.245603Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# Generate the submission file\n\nLet's get the test data","metadata":{}},{"cell_type":"code","source":"test_dataset = to_hf_dataset(\n    df_test.assign(label=0)  # placeholder column, ignored at inference\n)\ntest_tokenized = test_dataset.map(tokenize_batch, batched=True)\ntest_tokenized = test_tokenized.rename_column(\"label\", \"labels\")\ntest_tokenized.set_format(type=\"torch\", columns=[\"input_ids\", \"attention_mask\", \"labels\"])\n\nraw_predictions = trainer.predict(test_tokenized)\npredictions = raw_predictions.predictions","metadata":{"execution":{"iopub.status.busy":"2026-07-25T09:07:24.247861Z","iopub.execute_input":"2026-07-25T09:07:24.24829Z","iopub.status.idle":"2026-07-25T09:07:53.801473Z","shell.execute_reply.started":"2026-07-25T09:07:24.248243Z","shell.execute_reply":"2026-07-25T09:07:53.800815Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"Now, we create a csv file with exactly 5195 entries plus a header row.\n\nThe file has 2 columns:\n- id (sorted in any order)\n- prediction (contains your predictions: 0 for entailment, 1 for neutral, 2 for contradiction)","metadata":{}},{"cell_type":"code","source":"submission = df_test.id.copy().to_frame()\nsubmission[\"prediction\"] = np.argmax(predictions, axis=1)\n\nsubmission","metadata":{"execution":{"iopub.status.busy":"2026-07-25T09:07:53.802609Z","iopub.execute_input":"2026-07-25T09:07:53.802989Z","iopub.status.idle":"2026-07-25T09:07:53.813386Z","shell.execute_reply.started":"2026-07-25T09:07:53.802964Z","shell.execute_reply":"2026-07-25T09:07:53.812725Z"},"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"submission.to_csv(\"submission.csv\", index=False)","metadata":{"execution":{"iopub.status.busy":"2026-07-25T09:07:53.814412Z","iopub.execute_input":"2026-07-25T09:07:53.814803Z","iopub.status.idle":"2026-07-25T09:07:53.836377Z","shell.execute_reply.started":"2026-07-25T09:07